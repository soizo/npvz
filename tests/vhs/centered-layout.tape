Output "/tmp/npvz-centered-layout.png"
Set Shell "bash"
Set Width 1200
Set Height 700
Set FontSize 14
Set TypingSpeed 10ms

Type "TERM=xterm-256color ./npvz"
Enter
Sleep 2s
Enter
Sleep 1s
Enter
Sleep 1s
Type "g"
Sleep 500ms
Type "1"
Enter
Sleep 500ms
Type "llllhhhhjjkk"
Sleep 500ms
Type "p"
Sleep 500ms
Type "j"
Enter
Sleep 500ms
